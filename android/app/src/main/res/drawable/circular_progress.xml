<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="ring" android:thicknessRatio="8" android:useLevel="false">
            <solid android:color="#3C4043" /> <!-- neutralGrey800 for track -->
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270">
            <shape
                android:shape="ring"
                android:thicknessRatio="8"
                android:useLevel="true">
                <solid android:color="#fb7414" /> <!-- primaryOrange -->
            </shape>
        </rotate>
    </item>
</layer-list>
