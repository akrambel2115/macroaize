# RevenueCat public SDK keys. These keys are intended for client applications,
# but access and entitlements must still be enforced by your backend.
IOS_PUBLIC_SDK_KEY=your_revenuecat_ios_public_sdk_key
ANDROID_PUBLIC_SDK_KEY=your_revenuecat_android_public_sdk_key

# Optional: use a RevenueCat test-store key during local development.
REVENUECAT_TEST_SDK_KEY=
USE_REVENUECAT_TEST_STORE=false

# Optional: override the default RevenueCat offering identifier.
OFFERING_KEY=default

# Optional: URL for the remote recipes library.
RECIPES_LIBRARY=
