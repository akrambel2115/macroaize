TERMS_LINK=
PRIVACY_LINK=
SHARE_URL_ANDROID=
SHARE_URL_IOS=
SCAN_LIMIT=
CHAT_LIMIT=
PROMO_EXTENSION_DAYS_MONTHLY=
PROMO_EXTENSION_DAYS_YEARLY=
