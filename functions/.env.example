# Never put the following values in this file or commit them. Configure them
# with `firebase functions:secrets:set <NAME>` instead.
# GEMINI_API_KEY
# USDA_API_KEY
# REVENUECAT_REST_API_KEY
# REVENUECAT_WEBHOOK_SECRET
# RIP_ENCRYPTION_KEY_V1
