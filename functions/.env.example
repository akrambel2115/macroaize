# Non-secret runtime configuration for local Firebase emulators.
INFLUENCER_MIN_WITHDRAWAL=
INFLUENCER_WITHDRAWAL_PROCESSING_DAYS=
EMAIL_FROM_ADDRESS=
EMAIL_TO_ADDRESS=
INFLUENCER_EARN_FOR_CODE=
