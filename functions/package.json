{
  "name": "calai-functions",
  "private": true,
  "engines": {
    "node": "^20"
  },
  "scripts": {
    "lint": "eslint --ext .ts .",
    "build": "tsc -p tsconfig.json",
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "start": "npm run build && firebase emulators:start --only functions,firestore",
    "simulate:webhook": "node tools/simulate-webhook.js",
    "deploy": "npm run build && firebase deploy --only functions:chargilyWebhook,functions:createChargilyPayment,firestore:rules"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.7.7",
    "dayjs": "^1.11.12",
    "dotenv": "^17.2.1",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.1",
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "typescript": "^5.4.5"
  }
}
