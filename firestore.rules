rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Subscriptions: only owner can read
    // no client writes allowed
    // All subscription modifications must go through backend functions
    // email verification is required 
    match /subscriptions/{userId} {
      allow read: if request.auth != null && 
                   request.auth.uid == userId &&
                   request.auth.token.email_verified == true;
      allow write: if false; // only backend functions can modify subscriptions
    }

    match /user_usage/{userId} {
      // A user can read their own usage to see their limits in the UI
      // email verification is required
      allow read: if request.auth != null && 
                   request.auth.uid == userId &&
                   request.auth.token.email_verified == true;
      // No one can write to this from the client
      allow write: if false; 
    }

    // no client access
    match /webhook_events/{id} {
      allow read, write: if false;
    }

    // no client access
    match /audit_logs/{id} {
      allow read, write: if false;
    }

    // read only for verified influencers themselves
    match /influencers/{userId} {
      // Require email verification for reading influencer data
      allow read: if request.auth != null && 
                   request.auth.uid == userId &&
                   request.auth.token.email_verified == true;
      // Only admins can create/update influencer records
      // prevent any writes containing 'rip' field to avoid plain text rip storage
      allow create, update: if request.auth.token.admin == true &&
                              !('rip' in request.resource.data) &&
                              !(request.resource.data.keys().hasAny(['rip']));
      allow delete: if false;
    }

    // no client access
    match /influencer_audit/{id} {
      allow read, write: if false;
    }

    // Secure withdrawal data with encrypted RIPs:  no client access
    // Only accessible through admin Cloud Functions with proper authentication
    match /withdrawals_secure/{id} {
      allow read, write: if false; // blocked from client access
    }

    // no client access
    match /mail/{id} {
      allow read, write: if false;
    }

    // Promo codes - backend only (used by triggers)
    match /promoCodes/{code} {
      allow read, write: if false;
    }

    // Notification audit logs - backend only
    match /notification_audit/{id} {
      allow read, write: if false;
    }

    // Promo audit logs - backend only
    match /promo_audit/{id} {
      allow read, write: if false;
    }

    // Version check logs - backend only
    match /version_checks/{id} {
      allow read, write: if false;
    }

    // Promo code usage: users can read their own promo usage status
    // Write only via Cloud Functions
    match /promoUses/{userId} {
      allow read: if request.auth != null && 
                   request.auth.uid == userId &&
                   request.auth.token.email_verified == true;
      allow write: if false; // only backend functions can modify
    }

    // users can only read/write their own tokens
    // Require email verification for FCM token management
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && 
                          request.auth.uid == userId &&
                          request.auth.token.email_verified == true;
    }
    
    // Users can read/write their own user document for meal tracking
    match /users/{userId} {
      allow read, write: if request.auth != null && 
                          request.auth.uid == userId &&
                          request.auth.token.email_verified == true;
    }
    
    // Calorie history for notifications - users can write their own data
    match /calorie_history/{docId} {
      allow read, write: if request.auth != null &&
                          request.auth.token.email_verified == true &&
                          // Document ID must start with the user's UID
                          docId.matches(request.auth.uid + '_.*');
    }

    // deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
