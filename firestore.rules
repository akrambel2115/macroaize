rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Subscriptions: only owner can read; NO CLIENT WRITES allowed for security
    // All subscription modifications must go through backend functions
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // No client writes - only backend functions can modify subscriptions
    }

    // --- NEW Usage Tracking Rules ---
    match /user_usage/{userId} {
      // A user can read their own usage to see their limits in the UI.
      allow read: if request.auth != null && request.auth.uid == userId;
      // NO ONE can write to this from the client. It MUST be done by a Cloud Function.
      allow write: if false; 
    }

    // --- NEW Premium Content Rules ---
    match /recipes/{recipeId} {
      // Only allow reads if user has an active premium subscription
      allow read: if request.auth != null && 
                   exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.isPremium == true &&
                   get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.endDate.toMillis() > request.time.toMillis();
      allow write: if false; // Only you can add recipes
    }

    match /custom_foods/{foodId} {
      // Only allow reads/writes if user has an active premium subscription
      allow read, write: if request.auth != null &&
                          exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid)) &&
                          get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.isPremium == true &&
                          get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.endDate.toMillis() > request.time.toMillis();
    }

    // Webhook idempotency records: no client access
    match /webhook_events/{id} {
      allow read, write: if false;
    }

    // Audit log: no client access (backend only)
    match /audit_logs/{id} {
      allow read, write: if false;
    }

    // Influencers collection: read-only for influencers themselves, no client writes
    match /influencers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth.token.admin == true;
      allow delete: if false;
    }

    // Influencer audit logs: no client access
    match /influencer_audit/{id} {
      allow read, write: if false;
    }

    // Email queue for notifications: no client access
    match /mail/{id} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
